pipeline {
    agent {
        label 'ecs-agent'
    }
    
    environment {
        AWS_REGION = 'us-east-1'
        EKS_CLUSTER_NAME = 'backend-dev-cluster'
        DOCKER_REGISTRY = '207837001318.dkr.ecr.eu-west-1.amazonaws.com'
        KUBE_NAMESPACE = 'novocart'
    }
    
    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }
        
        stage('Build All Services') {
            parallel {
                stage('Build Auth Service') {
                    steps {
                        echo 'Building auth-service...'
                        sh '''
                            cd app/backend/auth-service
                            ./mvnw clean package -DskipTests
                        '''
                    }
                }
                stage('Build Product Service') {
                    steps {
                        echo 'Building product-service...'
                        sh '''
                            cd app/backend/product-service
                            ./mvnw clean package -DskipTests
                        '''
                    }
                }
                stage('Build Order Service') {
                    steps {
                        echo 'Building order-service...'
                        sh '''
                            cd app/backend/order-service
                            ./mvnw clean package -DskipTests
                        '''
                    }
                }
            }
        }
        
        stage('Test All Services') {
            parallel {
                stage('Test Auth Service') {
                    steps {
                        echo 'Testing auth-service...'
                        sh '''
                            cd app/backend/auth-service
                            ./mvnw test
                        '''
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'app/backend/auth-service/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('Test Product Service') {
                    steps {
                        echo 'Testing product-service...'
                        sh '''
                            cd app/backend/product-service
                            ./mvnw test
                        '''
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'app/backend/product-service/target/surefire-reports/*.xml'
                        }
                    }
                }
                stage('Test Order Service') {
                    steps {
                        echo 'Testing order-service...'
                        sh '''
                            cd app/backend/order-service
                            ./mvnw test
                        '''
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'app/backend/order-service/target/surefire-reports/*.xml'
                        }
                    }
                }
            }
        }
        
        stage('Build Docker Images') {
            agent {
                label 'master'
            }
            steps {
                echo 'Logging into ECR and building Docker images...'
                sh """
                    # Login to ECR
                    aws ecr get-login-password --region eu-west-1 | sudo docker login --username AWS --password-stdin ${DOCKER_REGISTRY}
                """
            }
            parallel {
                stage('Build Auth Service Image') {
                    steps {
                        script {
                            def imageTag = "${env.BUILD_NUMBER}"
                            def fullImageName = "${DOCKER_REGISTRY}/novocart/auth-service:${imageTag}"
                            
                            sh """
                                cd app/backend/auth-service
                                sudo docker build -t ${fullImageName} .
                                sudo docker tag ${fullImageName} ${DOCKER_REGISTRY}/novocart/auth-service:latest
                            """
                            
                            env.AUTH_DOCKER_IMAGE = fullImageName
                        }
                    }
                }
                stage('Build Product Service Image') {
                    steps {
                        script {
                            def imageTag = "${env.BUILD_NUMBER}"
                            def fullImageName = "${DOCKER_REGISTRY}/novocart/product-service:${imageTag}"
                            
                            sh """
                                cd app/backend/product-service
                                sudo docker build -t ${fullImageName} .
                                sudo docker tag ${fullImageName} ${DOCKER_REGISTRY}/novocart/product-service:latest
                            """
                            
                            env.PRODUCT_DOCKER_IMAGE = fullImageName
                        }
                    }
                }
                stage('Build Order Service Image') {
                    steps {
                        script {
                            def imageTag = "${env.BUILD_NUMBER}"
                            def fullImageName = "${DOCKER_REGISTRY}/novocart/order-service:${imageTag}"
                            
                            sh """
                                cd app/backend/order-service
                                sudo docker build -t ${fullImageName} .
                                sudo docker tag ${fullImageName} ${DOCKER_REGISTRY}/novocart/order-service:latest
                            """
                            
                            env.ORDER_DOCKER_IMAGE = fullImageName
                        }
                    }
                }
            }
        }
        
        stage('Push Docker Images') {
            agent {
                label 'master'
            }
            steps {
                echo 'Pushing Docker images to ECR registry...'
                sh """
                    # Login to ECR
                    aws ecr get-login-password --region eu-west-1 | sudo docker login --username AWS --password-stdin ${DOCKER_REGISTRY}
                """
            }
            parallel {
                stage('Push Auth Service Image') {
                    steps {
                        sh """
                            sudo docker push ${AUTH_DOCKER_IMAGE}
                            sudo docker push ${DOCKER_REGISTRY}/novocart/auth-service:latest
                        """
                    }
                }
                stage('Push Product Service Image') {
                    steps {
                        sh """
                            sudo docker push ${PRODUCT_DOCKER_IMAGE}
                            sudo docker push ${DOCKER_REGISTRY}/novocart/product-service:latest
                        """
                    }
                }
                stage('Push Order Service Image') {
                    steps {
                        sh """
                            sudo docker push ${ORDER_DOCKER_IMAGE}
                            sudo docker push ${DOCKER_REGISTRY}/novocart/order-service:latest
                        """
                    }
                }
            }
        }
        
        stage('Deploy to EKS') {
            steps {
                echo 'Deploying all services to EKS cluster...'
                script {
                    sh """
                        # Configure kubectl for EKS
                        aws eks update-kubeconfig --region ${AWS_REGION} --name ${EKS_CLUSTER_NAME}
                        
                        # Create namespace and configmap
                        kubectl apply -f app/k8s/namespace.yaml
                        kubectl apply -f app/k8s/configmap.yaml
                        
                        # Update image tags in deployments
                        sed -i 's|image: novocart/auth-service:latest|image: ${AUTH_DOCKER_IMAGE}|g' app/backend/auth-service/k8s/deployment.yaml
                        sed -i 's|image: novocart/product-service:latest|image: ${PRODUCT_DOCKER_IMAGE}|g' app/backend/product-service/k8s/deployment.yaml
                        sed -i 's|image: novocart/order-service:latest|image: ${ORDER_DOCKER_IMAGE}|g' app/backend/order-service/k8s/deployment.yaml
                        
                        # Apply all Kubernetes manifests
                        kubectl apply -f app/backend/auth-service/k8s/
                        kubectl apply -f app/backend/product-service/k8s/
                        kubectl apply -f app/backend/order-service/k8s/
                        kubectl apply -f app/k8s/ingress.yaml
                        
                        # Wait for all deployments to be ready
                        kubectl rollout status deployment/auth-service -n ${KUBE_NAMESPACE} --timeout=300s
                        kubectl rollout status deployment/product-service -n ${KUBE_NAMESPACE} --timeout=300s
                        kubectl rollout status deployment/order-service -n ${KUBE_NAMESPACE} --timeout=300s
                    """
                }
            }
        }
        
        stage('Health Check') {
            steps {
                echo 'Performing health checks...'
                script {
                    sh """
                        # Wait for all pods to be ready
                        kubectl wait --for=condition=ready pod -l app=auth-service -n ${KUBE_NAMESPACE} --timeout=300s
                        kubectl wait --for=condition=ready pod -l app=product-service -n ${KUBE_NAMESPACE} --timeout=300s
                        kubectl wait --for=condition=ready pod -l app=order-service -n ${KUBE_NAMESPACE} --timeout=300s
                        
                        # Get service endpoints
                        kubectl get services -n ${KUBE_NAMESPACE}
                        kubectl get ingress -n ${KUBE_NAMESPACE}
                        
                        echo "All backend services deployed successfully!"
                    """
                }
            }
        }
    }
    
    post {
        always {
            echo 'Cleaning up workspace...'
            deleteDir()
        }
        success {
            echo 'Backend deployment successful!'
        }
        failure {
            echo 'Backend deployment failed!'
        }
    }
}
